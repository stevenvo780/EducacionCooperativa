{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/check-subscriptions",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/drain-outbox",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/upload",
      "methods": ["POST"],
      "headers": {
        "x-vercel-proxy-request-body-size": "52428800"
      }
    },
    {
      "src": "/api/documents/convert",
      "methods": ["POST"],
      "headers": {
        "x-vercel-proxy-request-body-size": "52428800"
      }
    },
    {
      "src": "/api/documents",
      "methods": ["POST"],
      "headers": {
        "x-vercel-proxy-request-body-size": "52428800"
      }
    },
    {
      "src": "/api/documents/(.*)",
      "methods": ["PUT", "PATCH"],
      "headers": {
        "x-vercel-proxy-request-body-size": "52428800"
      }
    }
  ]
}
