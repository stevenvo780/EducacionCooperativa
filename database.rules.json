{
  "rules": {
    "sync-events": {
      "$workspaceId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"],
        "$eventId": {
          ".validate": "newData.hasChildren(['type', 'path', 'timestamp'])"
        }
      }
    },
    "presence": {
      "$wsId": {
        ".read": "auth != null",
        ".write": "auth != null && (!$wsId.beginsWith('personal_') || $wsId === 'personal_' + auth.uid)"
      }
    }
  }
}