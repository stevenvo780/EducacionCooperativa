rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cost-optimized rules ──
    // All shared-workspace authorization is enforced server-side via Admin SDK.
    // Client-side Firestore access (board API) uses custom claims to avoid
    // expensive get()/exists() calls in rules — each one is a billed read.
    //
    // Custom claim: request.auth.token.workspaces = ["wsId1", "wsId2", ...]
    // Set via Admin SDK when user joins/leaves a workspace.

    // Helper: check if user is a sync-agent via custom claims
    function isSyncAgent() {
      return request.auth != null &&
             request.auth.token.role == 'sync-agent';
    }

    // Helper: get the workspaceId from sync-agent claims
    function getSyncAgentWorkspaceId() {
      return request.auth.token.workspaceId;
    }

    // Helper: check workspace membership via custom claims (zero extra reads)
    function isMemberViaClaim(wsId) {
      return request.auth.token.workspaces != null &&
             wsId in request.auth.token.workspaces;
    }

    // Helper: personal workspace check
    function isPersonalWs(wsId) {
      return wsId != null && wsId.matches('^personal:.*');
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ST Notebooks subcollection (Ciclo 4 A4-C)
    match /users/{uid}/notebooks/{notebookId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // User emails index (used by registration)
    match /userEmails/{emailId} {
      allow read: if false; // server-only via Admin SDK
    }

    // Subscriptions (server-managed)
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.members;
      allow read: if isSyncAgent() && getSyncAgentWorkspaceId() == workspaceId;
      allow write: if request.auth != null &&
                      resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Documents collection — most operations go through Admin SDK API routes;
    // client reads may still happen for offline persistence / cache.
    match /documents/{docId} {
      // Owner always has access (personal docs)
      allow read, update, delete: if request.auth != null &&
                            resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid;

      // Shared workspace: use custom claim instead of get()/exists() — saves 2 reads per op
      allow read, update, delete: if request.auth != null &&
                            resource.data.workspaceId != null &&
                            !isPersonalWs(resource.data.workspaceId) &&
                            isMemberViaClaim(resource.data.workspaceId);
      allow create: if request.auth != null &&
                       request.resource.data.workspaceId != null &&
                       !isPersonalWs(request.resource.data.workspaceId) &&
                       isMemberViaClaim(request.resource.data.workspaceId);

      // Sync-agent access
      allow list: if isSyncAgent();
      allow read, write: if isSyncAgent() &&
                            resource.data.workspaceId == getSyncAgentWorkspaceId();
      allow create: if isSyncAgent() &&
                       request.resource.data.workspaceId == getSyncAgentWorkspaceId();
    }

    // Folders collection
    match /folders/{folderId} {
      allow read, update, delete: if request.auth != null &&
                            resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid;

      // Shared workspace via custom claim
      allow read, update, delete: if request.auth != null &&
                            resource.data.workspaceId != null &&
                            !isPersonalWs(resource.data.workspaceId) &&
                            isMemberViaClaim(resource.data.workspaceId);
      allow create: if request.auth != null &&
                       request.resource.data.workspaceId != null &&
                       !isPersonalWs(request.resource.data.workspaceId) &&
                       isMemberViaClaim(request.resource.data.workspaceId);

      // Sync-agent access
      allow list: if isSyncAgent();
      allow read, update, delete: if isSyncAgent() &&
                            resource.data.workspaceId == getSyncAgentWorkspaceId();
      allow create: if isSyncAgent() &&
                       request.resource.data.workspaceId == getSyncAgentWorkspaceId();
    }

    // Boards collection and subcollections
    match /boards/{boardId} {
      // Personal board or workspace board via custom claim (zero extra reads)
      function canAccessBoard() {
        return (boardId == 'personal:' + request.auth.uid) ||
               isMemberViaClaim(boardId);
      }

      allow read: if request.auth != null && canAccessBoard();
      allow create, update: if request.auth != null && canAccessBoard();

      match /columns/{columnId} {
        allow read, write: if request.auth != null && canAccessBoard();
      }

      match /cards/{cardId} {
        allow read, write: if request.auth != null && canAccessBoard();
      }
    }
  }
}
