{
  "extends": [
    "next/core-web-vitals"
  ],
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-duplicate-imports": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "error",
    "prefer-const": "error",
    "object-shorthand": "error",
    "prefer-template": "error",
    "no-unneeded-ternary": "error",
    "no-useless-return": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "yoda": ["error", "never"],
    "curly": ["error", "multi-line"],
    "no-multiple-empty-lines": ["error", { "max": 1, "maxEOF": 0 }],
    "no-trailing-spaces": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true, "allowTemplateLiterals": true }],
    "comma-dangle": ["error", "never"],
    "template-curly-spacing": ["error", "never"],
    "object-curly-spacing": ["error", "always"],
    "array-bracket-spacing": ["error", "never"],
    "arrow-spacing": ["error", { "before": true, "after": true }],
    "keyword-spacing": ["error", { "before": true, "after": true }],
    "space-before-blocks": ["error", "always"],
    "space-infix-ops": "error",
    "no-multi-spaces": "error",
    "react/jsx-curly-spacing": ["error", { "when": "never", "children": true }],
    "react/self-closing-comp": ["error", { "component": true, "html": true }],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value='sync-events/personal']",
        "message": "Canal RTDB inválido: el cliente escucha 'sync-events/personal_<uid>'. Usa resolveSyncChannel() de @/lib/contracts."
      },
      {
        "selector": "MemberExpression[object.object.name='process'][object.property.name='env'][property.name='WORKER_SECRET']:not(:has(CallExpression[callee.property.name='trim']))",
        "message": "WORKER_SECRET debe leerse con .trim() — newlines silentes rompen la firma HMAC."
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**/*", "scripts/**/*"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/app/api/**/*"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "services/",
    "public/sw.js",
    "public/workbox-*.js",
    "src/generated/",
    "*.config.js",
    "*.config.ts",
    "*.config.mjs"
  ]
}
