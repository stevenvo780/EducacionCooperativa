{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "unit/**/*.ts",
    "setup/**/*.ts",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../coverage",
    "../.next"
  ]
}
